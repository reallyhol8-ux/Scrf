	local function serverHop()
		if not caps.http then
			-- ไม่มีทางดึงรายชื่อเซิร์ฟจากฝั่งผู้เล่นได้ -> สุ่มเข้าเซิร์ฟใหม่แทน
			notify("ที่นี่ดึงรายชื่อเซิร์ฟไม่ได้ จึงสุ่มย้ายเซิร์ฟใหม่แทน...")
			task.spawn(function()
				local ok = pcall(function()
					TeleportService:Teleport(game.PlaceId, lp)
				end)
				if not ok then
					notify("ย้ายเซิร์ฟไม่สำเร็จ (เทสใน Studio ไม่ได้)")
				end
			end)
			return
		end
		notify("กำลังหาเซิร์ฟเวอร์คนน้อย...")
		task.spawn(function()
			local ok, res = pcall(function()
				local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
				return HttpService:JSONDecode(game:HttpGet(url))
			end)
			if not ok or type(res) ~= "table" or type(res.data) ~= "table" then
				notify("ดึงรายชื่อเซิร์ฟไม่ได้ (ต้องรองรับ HttpGet)")
				return
			end
			local pick = nil
			for _, s in res.data do
				if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
					if not pick or s.playing < pick.playing then
						pick = s
					end
				end
			end
			if not pick then
				notify("ไม่พบเซิร์ฟเวอร์อื่น")
				return
			end
			notify(("ย้ายไปเซิร์ฟที่มี %d คน..."):format(pick.playing))
			local ok2 = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, lp)
			end)
			if not ok2 then
				notify("ย้ายเซิร์ฟไม่สำเร็จ")
			end
		end)
	end
	local function rejoin()
		notify("กำลังรีเชิฟ...")
		task.spawn(function()
			local ok = pcall(function()
				if #Players:GetPlayers() <= 1 then
					TeleportService:Teleport(game.PlaceId, lp)
				else
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
				end
			end)
			if not ok then
				notify("รีเชิฟไม่สำเร็จ")
			end
		end)
	end
	local function runExternal(info)
		if not caps.ext then
			notify("ใช้ไม่ได้ใน LocalScript ปกติ (ต้องมี HttpGet + loadstring)")
			return
		end
		notify("กำลังโหลด: " .. info.name)
		task.spawn(function()
			local ok, err = pcall(function()
				loadstring(game:HttpGet("https://encrypt-x.pages.dev/Scripts?Id=" .. info.id))(info.id)
			end)
			if ok then
				notify("โหลดแล้ว: " .. info.name)
			else
				notify("โหลดไม่สำเร็จ: " .. tostring(err))
			end
		end)
	end

