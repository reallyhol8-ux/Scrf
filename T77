local SKY = {
	dayTop = col(C.sky1), dayBot = col(C.sky2),
	duskTop = col("#e8875a"), duskBot = col("#f7c98b"),
	nightTop = col("#0b1530"), nightBot = col("#22386b"),
}
local CLOUD_NIGHT = col("#4b5a86")
local GRASS_NIGHT = Color3.new(0.08, 0.14, 0.2)

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- ความมืด 0 = กลางวันเต็ม, 1 = กลางคืนเต็ม (t = วินาทีในรอบ)
local function nightAmount(t)
	if t >= CYCLE - TWILIGHT then
		return 1 - smooth((t - (CYCLE - TWILIGHT)) / (TWILIGHT * 2))
	elseif t < TWILIGHT then
		return 1 - smooth((t + TWILIGHT) / (TWILIGHT * 2))
	elseif t < DAY_SEC - TWILIGHT then
		return 0
	elseif t < DAY_SEC + TWILIGHT then
		return smooth((t - (DAY_SEC - TWILIGHT)) / (TWILIGHT * 2))
	end
	return 1
end

-- สีฟ้า: เช้า/เย็นผ่านสีส้มก่อน
local function skyColors(n)
	if n < 0.5 then
		local k = n * 2
		return SKY.dayTop:Lerp(SKY.duskTop, k), SKY.dayBot:Lerp(SKY.duskBot, k)
	end
	local k = (n - 0.5) * 2
	return SKY.duskTop:Lerp(SKY.nightTop, k), SKY.duskBot:Lerp(SKY.nightBot, k)
end

-- ลูปหลัก: เหรียญหมุน + ท้องฟ้า
local ang = 0
local spinBoost = Instance.new("NumberValue")
spinBoost.Value = 1
local lastN = -1
local t0 = os.clock()

local spinConn = RunService.RenderStepped:Connect(function(dt)
	-- ขอบ RGB หมุน
	local rot = (os.clock() * 140) % 360
	for _, g in rainbows do
		g.Rotation = rot
	end

	-- เหรียญ
	ang = (ang + dt * math.pi * 2 / 2.6 * spinBoost.Value) % (math.pi * 2)
	local c = math.cos(ang)
	local w = math.max(2, math.abs(c) * COIN)
	for _, coin in coins do
		if coin.owner.Visible then
			coin.spin.Size = UDim2.fromOffset(w, COIN)
			coin.front.Visible = c >= 0
			coin.back.Visible = c < 0
		end
	end

	-- ท้องฟ้า (อัปเดตเฉพาะตอนเห็นหน้าต่าง)
	if not win.holder.Visible then
		return
	end

	local clock = os.clock() - t0
	local t = clock % CYCLE
	local n = nightAmount(t)

	-- สีฟ้า/เมฆ/หญ้า เปลี่ยนเฉพาะตอนค่ามืดเปลี่ยนจริง ๆ
	if math.abs(n - lastN) > 0.003 then
		lastN = n
		local top, bot = skyColors(n)
		sky.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, top),
			ColorSequenceKeypoint.new(0.7, bot),
			ColorSequenceKeypoint.new(1, bot),
		})
		for _, cl in clouds do
			tint(cl.pieces, CLOUD_NIGHT, n * 0.85)
		end
		tint(grassPieces, GRASS_NIGHT, n * 0.6)
	end

	-- พระอาทิตย์ (กลางวัน) / ดวงจันทร์ (กลางคืน) วิ่งเป็นโค้งข้ามจอ
	if t < DAY_SEC then
		local p = t / DAY_SEC
		sun.Visible = true
		moon.Visible = false
		sun.Position = UDim2.fromOffset(
			math.floor(-SUN_W + (W + SUN_W) * p + 0.5),
			math.floor(46 - 42 * math.sin(math.pi * p) + 0.5)
		)
	else
		local p = (t - DAY_SEC) / NIGHT_SEC
		sun.Visible = false
		moon.Visible = true
		moon.Position = UDim2.fromOffset(
			math.floor(-MOON_W + (W + MOON_W) * p + 0.5),
			math.floor(46 - 38 * math.sin(math.pi * p) + 0.5)
		)
	end

	-- เมฆลอยจากขวาไปซ้ายวนไปเรื่อย ๆ
	for _, cl in clouds do
		local x = (cl.x0 - cl.speed * clock) % (W + cl.w) - cl.w
		cl.frame.Position = UDim2.fromOffset(math.floor(x + 0.5), cl.y)
	end

	-- ดาวกะพริบ
	for i, s in stars do
		if n > 0.01 then
			local tw = 0.5 + 0.5 * math.sin(clock * 2.2 + i * 1.7)
			s.BackgroundTransparency = 1 - n * (0.4 + 0.6 * tw)
		elseif s.BackgroundTransparency < 1 then
			s.BackgroundTransparency = 1
		end
	end
end)
