-- เบลอฉากหลังเกม (BlurEffect เบลอเฉพาะโลก 3D ไม่เบลอ UI)
local blur = nil
local function blurTo(size)
	if GLASS_BLUR <= 0 then
		return
	end
	if not blur then
		if size == 0 then
			return
		end
		blur = make("BlurEffect", { Name = "TokenHubBlur", Size = 0 }, Lighting)
	end
	local b = blur
	local tw = TweenService:Create(b, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = size })
	if size == 0 then
		tw.Completed:Connect(function(playState)
			if playState == Enum.PlaybackState.Completed and blur == b then
				b:Destroy()
				blur = nil
			end
		end)
	end
	tw:Play()
end

gui.Destroying:Connect(function()
	if blur then
		blur:Destroy()
		blur = nil
	end
end)

local confirmToken = 0

local function glassPos(dy)
	local c = win:center()
	return UDim2.fromOffset(c.X, c.Y + (dy or 0))
end

-- ตอนลาก/ย่อจอ ให้กล่องตามหน้าต่าง
onUiMoved = function()
	if confirmOpen then
		glass.Position = glassPos()
	end
end

local function openConfirm()
	if blocked() or state ~= "open" then
		return
	end
	confirmOpen = true
	confirmToken += 1

	glass.Position = glassPos(16)
	glass.GroupTransparency = 1
	glassScale.Scale = 0.6
	glass.Visible = true
	confirmDim.BackgroundTransparency = 1
	confirmDim.Visible = true

	TweenService:Create(confirmDim, tFade, { BackgroundTransparency = 0.42 }):Play()
	TweenService:Create(glassScale, tJelly, { Scale = 1 }):Play()
	TweenService:Create(glass, tMove, { Position = glassPos(), GroupTransparency = 0 }):Play()

	shine.Position = UDim2.new(0, -40, 0.5, 0)
	shineTween:Play()
	blurTo(GLASS_BLUR)
end

local function closeConfirm()
	if not confirmOpen then
		return
	end
	confirmOpen = false
	confirmToken += 1
	local mine = confirmToken

	shineTween:Cancel()
	TweenService:Create(glassScale, tOut, { Scale = 0.85 }):Play()

	local f = TweenService:Create(glass, tOut, { GroupTransparency = 1 })
	f.Completed:Connect(function()
		if confirmToken == mine then
			glass.Visible = false
		end
	end)
	f:Play()

	local d = TweenService:Create(confirmDim, tOut, { BackgroundTransparency = 1 })
	d.Completed:Connect(function()
		if confirmToken == mine then
			confirmDim.Visible = false
		end
	end)
	d:Play()

	blurTo(0)
end

-- ลบออก: กล่องจางหาย -> หน้าต่างหดเป็นจุด -> ทำลาย UI
local function removeAll()
	if not confirmOpen then
		return
	end
	confirmOpen = false
	removing = true
	confirmToken += 1

	shineTween:Cancel()
	TweenService:Create(glassScale, tOut, { Scale = 0.85 }):Play()
	TweenService:Create(glass, tOut, { GroupTransparency = 1 }):Play()
	TweenService:Create(confirmDim, tOut, { BackgroundTransparency = 1 }):Play()
	blurTo(0)

	task.wait(0.18)
	win:hide(win:center())
	task.wait(0.4)
	gui:Destroy()
end

cancelBtn.Activated:Connect(closeConfirm)
removeBtn.Activated:Connect(function()
	task.spawn(removeAll)
end)
confirmDim.Activated:Connect(closeConfirm)

closeBtn.Activated:Connect(openConfirm)

