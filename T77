	local br = { s = nil }
	local function brApply()
		if not br.s then
			local s = {
				b = Lit.Brightness, a = Lit.Ambient, o = Lit.OutdoorAmbient,
				e = Lit.ExposureCompensation, fe = Lit.FogEnd, atm = {},
			}
			for _, a in Lit:GetChildren() do
				if a:IsA("Atmosphere") then
					s.atm[a] = a.Density
				end
			end
			br.s = s
		end
		local s, t = br.s, S.bright / 10
		Lit.Brightness = s.b + t * 4
		Lit.Ambient = s.a:Lerp(WHITE, t)
		Lit.OutdoorAmbient = s.o:Lerp(WHITE, t)
		Lit.ExposureCompensation = s.e + t * 1.2
		if t >= 0.3 then
			Lit.FogEnd = math.max(s.fe, 1e5)
		end
		for a, d in s.atm do
			if a.Parent then
				a.Density = d * (1 - t)
			end
		end
	end
	local function brRestore()
		local s = br.s
		if not s then
			return
		end
		Lit.Brightness, Lit.Ambient, Lit.OutdoorAmbient = s.b, s.a, s.o
		Lit.ExposureCompensation, Lit.FogEnd = s.e, s.fe
		for a, d in s.atm do
			if a.Parent then
				a.Density = d
			end
		end
		br.s = nil
	end

