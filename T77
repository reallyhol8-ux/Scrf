-- ===== INTRO (~3 วิ) =====
-- 0.00  จุดเล็ก ๆ ขอบ RGB เด้งขึ้นแล้วยืดเป็นแคปซูลยาว
-- 0.60  พิมพ์ TOKEN HUB ทีละตัว
-- 1.30  ชื่อสไลด์ไปขวา + กล่องไอคอนเด้ง -> เหรียญหมุนเร็วแล้วช้าลง -> ปุ่ม - และ X เด้ง
-- 1.85  หน้าต่างคลี่ลงมา มุมค่อย ๆ จากแคปซูลเป็นเหลี่ยมมน ท้องฟ้ากับเนื้อหาโผล่ตามมา
-- 3.00  เสร็จ ปลดล็อกปุ่ม
local INTRO_TOTAL = 3.0
local EASE_Q = Enum.EasingStyle.Quint
local EASE_B = Enum.EasingStyle.Back
local EASE_QUAD = Enum.EasingStyle.Quad
local DIR_OUT = Enum.EasingDirection.Out

local function ti(t, style)
	return TweenInfo.new(t, style or EASE_Q, DIR_OUT)
end

local function tween(inst, info, goal)
	TweenService:Create(inst, info, goal):Play()
end

local function playIntro()
	introBusy = true
	state = "open"
	setPos(uiPos, WIN_SIZE)

	local h = win.holder
	local cx = uiPos.X + WIN_SIZE.X / 2
	local capY = uiPos.Y + HEADER / 2 -- กลางแคปซูล
	local fullY = uiPos.Y + WIN_SIZE.Y / 2 -- กลางหน้าต่างเต็ม (ขอบบนอยู่ที่เดิมตลอด)

	-- เริ่มต้น: ซ่อนทุกอย่างไว้ก่อน เหลือแค่จุดขอบ RGB
	win.token += 1
	win.canvas.GroupTransparency = 1
	win.scale.Scale = 0.3
	win.stroke.Transparency = 1
	for _, c in win.corners do
		c.CornerRadius = UDim.new(0, HEADER / 2)
	end
	h.Size = UDim2.fromOffset(10, 10)
	h.Position = UDim2.fromOffset(cx, capY)
	h.Visible = true
	dragHeader.Visible = false

	introCover.BackgroundTransparency = 0
	bodyCover.BackgroundTransparency = 0
	iconPop.Scale = 0.01
	coinPop.Scale = 0.01
	minPop.Scale = 0.01
	closePop.Scale = 0.01
	spinBoost.Value = 1

	local titleEnd = {}
	for i, l in titleLabels do
		titleEnd[i] = l.Position
		l.Position = l.Position - UDim2.fromOffset(36, 0)
		l.MaxVisibleGraphemes = 0
	end

	-- 0.00 จุด -> แคปซูล
	tween(h, ti(0.55), { Size = UDim2.fromOffset(WIN_SIZE.X, HEADER) })
	tween(win.scale, ti(0.5, EASE_B), { Scale = 1 })
	tween(win.stroke, TweenInfo.new(0.15), { Transparency = 0 })
	task.delay(0.35, function()
		tween(win.canvas, ti(0.25, EASE_QUAD), { GroupTransparency = 0 })
	end)

	-- 0.60 พิมพ์ชื่อ
	task.delay(0.6, function()
		local total = utf8.len(titleLabels[1].Text) or 9
		for i = 1, total do
			for _, l in titleLabels do
				l.MaxVisibleGraphemes = i
			end
			task.wait(0.075)
		end
		for _, l in titleLabels do
			l.MaxVisibleGraphemes = -1
		end
	end)

	-- 1.30 ชื่อสไลด์ไปขวา + กล่องไอคอนเด้ง
	task.delay(1.3, function()
		for i, l in titleLabels do
			tween(l, ti(0.6), { Position = titleEnd[i] })
		end
		tween(iconPop, ti(0.45, EASE_B), { Scale = 1 })
	end)
	-- 1.55 เหรียญเด้ง หมุนเร็วแล้วค่อยช้าลง
	task.delay(1.55, function()
		tween(coinPop, ti(0.5, EASE_B), { Scale = 1 })
		spinBoost.Value = 9
		tween(spinBoost, TweenInfo.new(1.3, EASE_QUAD, DIR_OUT), { Value = 1 })
	end)
	-- 1.60 / 1.70 ปุ่ม - และ X เด้ง
	task.delay(1.6, function()
		tween(minPop, ti(0.35, EASE_B), { Scale = 1 })
	end)
	task.delay(1.7, function()
		tween(closePop, ti(0.35, EASE_B), { Scale = 1 })
	end)

	-- 1.85 คลี่หน้าต่างลงมา (ขนาด + ตำแหน่งใช้ tween เดียวกัน ขอบบนเลยนิ่ง) + มุมโค้ง -> เหลี่ยมมน
	task.delay(1.85, function()
		tween(h, ti(0.85), {
			Size = UDim2.fromOffset(WIN_SIZE.X, WIN_SIZE.Y),
			Position = UDim2.fromOffset(cx, fullY),
		})
		for _, c in win.corners do
			tween(c, ti(0.85), { CornerRadius = UDim.new(0, 8) })
		end
	end)
	-- ท้องฟ้า / เนื้อหาค่อย ๆ โผล่
	task.delay(1.95, function()
		tween(introCover, ti(0.7, EASE_QUAD), { BackgroundTransparency = 1 })
	end)
	task.delay(2.15, function()
		tween(bodyCover, ti(0.6, EASE_QUAD), { BackgroundTransparency = 1 })
	end)

	-- 3.00 เสร็จ
	task.delay(INTRO_TOTAL, function()
		h.Size = UDim2.fromOffset(WIN_SIZE.X, WIN_SIZE.Y)
		h.Position = win:target()
		for _, c in win.corners do
			c.CornerRadius = UDim.new(0, 8)
		end
		for _, l in titleLabels do
			l.MaxVisibleGraphemes = -1
		end
		introCover.Visible = false
		bodyCover.Visible = false
		dragHeader.Visible = true
		introBusy = false
	end)
end

