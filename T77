	local TeleportService = game:GetService("TeleportService")
	local HttpService = game:GetService("HttpService")
	local Workspace = workspace
	local WHITE = Color3.new(1, 1, 1)
	local BOLD = Enum.Font.GothamBold
	local MED = Enum.Font.GothamMedium

	-- ---------- ตั้งค่า ----------
	local S = { fly = 50, speed = 50, hitbox = 5, pull = 5, bright = 5 }
	local AIM_RANGE = 600 -- ระยะล็อกเป้า (studs)
	local PULL_RANGE = 300 -- ระยะที่แรงดูดทำงาน
	local INVIS_OFFSET = Vector3.new(0, 50000, 0) -- หายตัว = พาตัวไปไกลขนาดนี้
	local EXTERNAL = {
		music = { name = "เปิดเพลงคนอื่นไม่ได้ยิน", id = "1465108175034" },
		steal = { name = "ดูดเพลง", id = "8011267776024" },
	}

	local mine = {} -- connection ของส่วนนี้ (ไว้ตัดตอนลบ UI)
	local function track(c)
		mine[#mine + 1] = c
		return c
	end

	local active, feats, ui = {}, {}, {}
	local setFeature
	local notify

	-- ---------- ตัวช่วย ----------
	local function getCam()
		return Workspace.CurrentCamera
	end
	local function getHum()
		local c = lp.Character
		return c and c:FindFirstChildOfClass("Humanoid")
	end
	local function getRoot()
		local c = lp.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local function noChar()
		notify("ตัวละครยังไม่พร้อม")
		return false
	end

	-- ตัวควบคุมของเกม (ใช้กับปุ่ม/จอยบนมือถือ)
	local controls = nil
	task.spawn(function()
		pcall(function()
			local pm = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10))
			controls = pm:GetControls()
		end)
	end)

	-- ทิศที่ผู้เล่นกดเดิน (อิงกล้อง ลอยขึ้น/ลงตามมุมกล้อง) + Space ขึ้น / Ctrl,Q ลง
	local function moveVector(c, h)
		local look, right = c.CFrame.LookVector, c.CFrame.RightVector
		local dir = nil
		if controls then
			local ok, mv = pcall(controls.GetMoveVector, controls)
			if ok and mv then
				dir = look * -mv.Z + right * mv.X
			end
		end
		if not dir then
			dir = Vector3.zero
			local md = h.MoveDirection
			if md.Magnitude > 0.01 then
				local fl = Vector3.new(look.X, 0, look.Z)
				local fr = Vector3.new(right.X, 0, right.Z)
				local f = fl.Magnitude > 0.01 and md:Dot(fl.Unit) or 0
				local s = fr.Magnitude > 0.01 and md:Dot(fr.Unit) or 0
				dir = look * f + (fr.Magnitude > 0.01 and fr.Unit or Vector3.zero) * s
			end
		end
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.Space) then
				dir += Vector3.yAxis
			end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then
				dir -= Vector3.yAxis
			end
		end
		if dir.Magnitude > 1 then
			dir = dir.Unit
		end
		return dir
	end

	-- ตัวติดตามบอท (Humanoid ที่ไม่ใช่ผู้เล่น)
	local bots = {}
	local function trackBot(d)
		if d:IsA("Humanoid") and d.Parent and not Players:GetPlayerFromCharacter(d.Parent) then
			bots[d] = true
		end
	end
	track(Workspace.DescendantAdded:Connect(trackBot))
	track(Workspace.DescendantRemoving:Connect(function(d)
		if bots[d] then
			bots[d] = nil
		end
	end))
	task.spawn(function()
		local n = 0
		for _, d in Workspace:GetDescendants() do
			trackBot(d)
			n += 1
			if n % 500 == 0 then
				task.wait()
			end
		end
	end)

	-- =====================================================================
	-- 1) บิน
	-- =====================================================================
	local fly = {}
	local function flyStop()
		if fly.bv then
			fly.bv:Destroy()
			fly.bv = nil
		end
		if fly.bg then
			fly.bg:Destroy()
			fly.bg = nil
		end
		local h = getHum()
		if h then
			h.PlatformStand = false
		end
	end
	local function flyStart()
		flyStop()
		local r, h = getRoot(), getHum()
		if not (r and h) then
			return false
		end
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.one * 1e9
		bv.Velocity = Vector3.zero
		bv.Parent = r
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.one * 1e9
		bg.P = 1e4
		bg.CFrame = r.CFrame
		bg.Parent = r
		fly.bv, fly.bg = bv, bg
		h.PlatformStand = true
		return true
	end
	local function flyUpdate(c, h)
		local r = getRoot()
		if not r then
			return
		end
		if not fly.bv or fly.bv.Parent ~= r then
			if not flyStart() then
				return
			end
		end
		fly.bv.Velocity = moveVector(c, h) * S.fly
		local look = c.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.05 then
			fly.bg.CFrame = CFrame.lookAt(r.Position, r.Position + flat)
		end
	end

	-- =====================================================================
	-- 2) ความเร็ววิ่ง   4) เดินทะลุ   5) วาปด้วยไอเทม
	-- =====================================================================
	local spd = {}
	local ncSaved = {}
	local function noclipStep()
		local c = lp.Character
		if not c then
			return
		end
		for _, p in c:GetDescendants() do
			if p:IsA("BasePart") and p.CanCollide then
				ncSaved[p] = true
				p.CanCollide = false
			end
		end
	end
	local function noclipRestore()
		for p in ncSaved do
			if p.Parent then
				p.CanCollide = true
			end
		end
		table.clear(ncSaved)
	end

	local tpTool = nil
	local function giveTpTool()
		if tpTool and tpTool.Parent then
			return
		end
		local bp = lp:FindFirstChildOfClass("Backpack")
		if not bp then
			return
		end
		local t = Instance.new("Tool")
		t.Name = "วาป"
		t.ToolTip = "คลิก/แตะที่พื้นเพื่อวาปไปจุดนั้น"
		t.RequiresHandle = false
		t.CanBeDropped = false
		t.Activated:Connect(function()
			local r = getRoot()
			local hit = lp:GetMouse().Hit
			if r and hit then
				r.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.5, 0)) * r.CFrame.Rotation
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end)
		t.Parent = bp
		tpTool = t
	end

	-- =====================================================================
	-- 8) มองผู้เล่นอื่น
	-- =====================================================================
	local spec = { target = nil, label = nil }
	local function specCandidates()
		local l = {}
		for _, p in Players:GetPlayers() do
			if p ~= lp then
				table.insert(l, p)
			end
		end
		table.sort(l, function(a, b)
			return a.Name:lower() < b.Name:lower()
		end)
		return l
	end
	local function specLabelUpdate()
		if spec.label then
			spec.label.Text = spec.target and spec.target.DisplayName or "— ไม่มี —"
		end
	end
	local function specShift(d)
		local l = specCandidates()
		if #l == 0 then
			spec.target = nil
			specLabelUpdate()
			if active.spectate then
				setFeature("spectate", false)
			end
			return
		end
		local i = table.find(l, spec.target) or 0
		spec.target = l[((i - 1 + d) % #l) + 1]
		specLabelUpdate()
	end
	local function specEnforce(c)
		local t = spec.target
		local th = t and t.Character and t.Character:FindFirstChildOfClass("Humanoid")
		if th and c.CameraSubject ~= th then
			c.CameraSubject = th
		end
	end

	-- =====================================================================
	-- 6) หายตัว (พาตัวไปไกลมาก กล้องยังอยู่ในแมพ)   10) มอง 3D (กล้องอิสระ)
	-- ทั้งคู่ใช้ "จุดกล้อง" (ghost) ที่ขยับด้วยปุ่มเดินเหมือนตอนบิน
	-- =====================================================================
	local ghost = { part = nil, mode = nil, token = 0, skip = false }
	local function ghostBegin(mode)
		local r, h, c = getRoot(), getHum(), getCam()
		if not (r and h and c) then
			return noChar()
		end
		if ghost.part then
			return false
		end
		local d = Instance.new("Part")
		d.Name = "TokenHubGhost"
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.Transparency = 1
		d.Size = Vector3.one
		d.CFrame = CFrame.new(r.Position + Vector3.new(0, 2, 0))
		d.Parent = Workspace
		ghost.part, ghost.mode = d, mode
		if not active.spectate then
			c.CameraSubject = d
		end
		if mode == "invis" then
			r.CFrame = CFrame.new(r.Position + INVIS_OFFSET)
			r.AssemblyLinearVelocity = Vector3.zero
			ghost.token += 1
			local my = ghost.token
			-- รอให้ตำแหน่งใหม่ส่งไปหาคนอื่นก่อน แล้วค่อยล็อกตัวไว้ไม่ให้ตก
			task.delay(0.3, function()
				if ghost.part == d and ghost.token == my then
					local rr = getRoot()
					if rr then
						rr.Anchored = true
					end
				end
			end)
		else
			r.Anchored = true
		end
		return true
	end
	local function ghostEnd()
		local g = ghost.part
		if not g then
			return
		end
		ghost.part = nil
		ghost.token += 1
		local pos = g.Position
		g:Destroy()
		local r, h, c = getRoot(), getHum(), getCam()
		if r then
			r.Anchored = false
			if ghost.mode == "invis" and not ghost.skip then
				-- โผล่ตรงที่กล้องอยู่
				r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end
		ghost.skip = false
		if c and h and not (active.spectate and spec.target) then
			c.CameraSubject = h
		end
	end
	local function ghostUpdate(c, h, dt)
		local g = ghost.part
		if not g or not h then
			return
		end
		if not active.spectate and c.CameraSubject ~= g then
			c.CameraSubject = g
		end
		g.CFrame = g.CFrame + moveVector(c, h) * S.fly * dt
	end

	-- =====================================================================
	-- 9) X-Ray
	-- =====================================================================
	local xr = { orig = setmetatable({}, { __mode = "k" }), conn = nil, token = 0, hl = {} }
	local function xrPart(p)
		if p:IsA("BasePart") and not p:IsA("Terrain") then
			local m = p:FindFirstAncestorWhichIsA("Model")
			if m and m:FindFirstChildOfClass("Humanoid") then
				return
			end
			if xr.orig[p] == nil then
				xr.orig[p] = p.Transparency
			end
			if p.Transparency < 0.65 then
				p.Transparency = 0.65
			end
		end
	end
	local function xrHighlights()
		for p, h in xr.hl do
			if not p.Parent then
				h:Destroy()
				xr.hl[p] = nil
			end
		end
		local n = 0
		for _, p in Players:GetPlayers() do
			if p ~= lp and p.Character and n < 30 then
				n += 1
				local h = xr.hl[p]
				if not h or not h.Parent or h.Adornee ~= p.Character then
					if h then
						h:Destroy()
					end
					h = Instance.new("Highlight")
					h.Name = "TokenHubXRay"
					h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					h.FillColor = Color3.fromRGB(255, 70, 70)
					h.FillTransparency = 0.55
					h.OutlineColor = WHITE
					h.Adornee = p.Character
					h.Parent = p.Character
					xr.hl[p] = h
				end
			end
		end
	end
	local function xrOn()
		xr.token += 1
		local my = xr.token
		xr.conn = Workspace.DescendantAdded:Connect(xrPart)
		xrHighlights()
		task.spawn(function()
			local n = 0
			for _, d in Workspace:GetDescendants() do
				if xr.token ~= my then
					return
				end
				xrPart(d)
				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end
		end)
	end
	local function xrOff()
		xr.token += 1
		if xr.conn then
			xr.conn:Disconnect()
			xr.conn = nil
		end
		for p, t in xr.orig do
			if p.Parent then
				p.Transparency = t
			end
		end
		table.clear(xr.orig)
		for p, h in xr.hl do
			h:Destroy()
			xr.hl[p] = nil
		end
	end

	-- =====================================================================
	-- 11) ขยาย Hitbox (ผู้เล่นอื่น + บอท)
	-- =====================================================================
	local hb = { orig = {} }
	local function hbOne(model)
		local r = model:FindFirstChild("HumanoidRootPart")
		if not r then
			return
		end
		if not hb.orig[r] then
			hb.orig[r] = { size = r.Size, tr = r.Transparency, cc = r.CanCollide, ms = r.Massless }
		end
		r.Size = Vector3.new(S.hitbox, S.hitbox, S.hitbox)
		r.Transparency = 0.8
		r.CanCollide = false
		r.Massless = true
	end
	local function hbApply()
		for _, p in Players:GetPlayers() do
			if p ~= lp and p.Character then
				hbOne(p.Character)
			end
		end
		for h in bots do
			local m = h.Parent
			if m and m ~= lp.Character and not Players:GetPlayerFromCharacter(m) then
				hbOne(m)
			end
		end
	end
	local function hbRestore()
		for r, o in hb.orig do
			if r.Parent then
				r.Size, r.Transparency, r.CanCollide, r.Massless = o.size, o.tr, o.cc, o.ms
			end
		end
		table.clear(hb.orig)
	end

	-- =====================================================================
	-- 12-13) ล็อกผู้เล่น / ล็อกบอท อัตโนมัติ   14) แรงดูด
	-- =====================================================================
	local function aimUpdate(c)
		local origin = c.CFrame.Position
		local best, bd = nil, AIM_RANGE
		local function consider(model)
			if model == lp.Character then
				return
			end
			local hum = model:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then
				return
			end
			local part = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
			if not part then
				return
			end
			local d = (part.Position - origin).Magnitude
			if d < bd then
				best, bd = part, d
			end
		end
		if active.lockp then
			for _, p in Players:GetPlayers() do
				if p ~= lp and p.Character then
					consider(p.Character)
				end
			end
		end
		if active.lockb then
			for hum in bots do
				local m = hum.Parent
				if not m then
					bots[hum] = nil
				elseif not Players:GetPlayerFromCharacter(m) then
					consider(m)
				end
			end
		end
		if best then
			c.CFrame = c.CFrame:Lerp(CFrame.lookAt(origin, best.Position), 0.6)
		end
	end

	local function pullStep()
		local c = getCam()
		local r = getRoot()
		local origin = ghost.part and ghost.part.Position or (r and r.Position)
		if not (origin and c) then
			return
		end
		local look = c.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.zAxis
		local goal = origin + flat * 4
		local a = (S.pull / 10) ^ 2 * 0.7 + 0.01 -- ระดับ 1 เบา ๆ ... ระดับ 10 แทบดูดทันที
		local function pullModel(m)
			local tr = m:FindFirstChild("HumanoidRootPart")
			if tr and (tr.Position - origin).Magnitude <= PULL_RANGE then
				tr.CFrame = tr.CFrame:Lerp(CFrame.new(goal) * tr.CFrame.Rotation, a)
				tr.AssemblyLinearVelocity = Vector3.zero
			end
		end
		for _, p in Players:GetPlayers() do
			if p ~= lp and p.Character then
				pullModel(p.Character)
			end
		end
		for hum in bots do
			local m = hum.Parent
			if m and m ~= lp.Character and not Players:GetPlayerFromCharacter(m) then
				pullModel(m)
			end
		end
	end

	-- =====================================================================
	-- 15-16) ลดกราฟิก / ภาพดินน้ำมัน   (level 1 = ลด, level 2 = ดินน้ำมัน)
	-- =====================================================================
	local gfx = { level = 0, token = 0, saved = setmetatable({}, { __mode = "k" }), sa = {}, light = nil, conn = nil }

	local function gfxState(d)
		local s = gfx.saved[d]
		if not s then
			s = {}
			gfx.saved[d] = s
		end
		return s
	end
	local function gfxInst(d, level)
		if d:IsA("Terrain") then
			return
		end
		if d:IsA("BasePart") then
			local s = gfxState(d)
			if s.m == nil then
				s.m, s.r, s.c = d.Material, d.Reflectance, d.CastShadow
			end
			d.CastShadow = false
			d.Reflectance = 0
			if level >= 2 then
				d.Material = Enum.Material.SmoothPlastic
				if d:IsA("MeshPart") then
					if s.t == nil then
						s.t = d.TextureID
					end
					d.TextureID = ""
				end
			end
		elseif d:IsA("Decal") then -- รวม Texture
			if level >= 2 then
				local s = gfxState(d)
				if s.tr == nil then
					s.tr = d.Transparency
				end
				d.Transparency = 1
			end
		elseif d:IsA("SurfaceAppearance") then
			if level >= 2 and d.Parent then
				gfx.sa[#gfx.sa + 1] = { d, d.Parent }
				d.Parent = nil
			end
		elseif
			d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
			or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
		then
			local s = gfxState(d)
			if s.en == nil then
				s.en = d.Enabled
			end
			d.Enabled = false
		elseif d:IsA("Light") then
			local s = gfxState(d)
			if s.sh == nil then
				s.sh = d.Shadows
			end
			d.Shadows = false
		end
	end
	local function gfxLightingOn()
		local L = { fx = {} }
		gfx.light = L
		L.gs, L.sp = Lit.GlobalShadows, Lit.EnvironmentSpecularScale
		Lit.GlobalShadows = false
		Lit.EnvironmentSpecularScale = 0
		for _, e in Lit:GetChildren() do
			if e:IsA("PostEffect") then
				L.fx[e] = e.Enabled
				e.Enabled = false
			end
		end
		local c = getCam()
		if c then
			for _, e in c:GetChildren() do
				if e:IsA("PostEffect") then
					L.fx[e] = e.Enabled
					e.Enabled = false
				end
			end
		end
		pcall(function()
			local t = Workspace.Terrain
			L.td, L.wr, L.ww = t.Decoration, t.WaterReflectance, t.WaterWaveSize
			t.Decoration = false
			t.WaterReflectance = 0
			t.WaterWaveSize = 0
		end)
		pcall(function()
			L.q = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
	end
	local function gfxRevert()
		if gfx.conn then
			gfx.conn:Disconnect()
			gfx.conn = nil
		end
		for d, s in gfx.saved do
			if d.Parent then
				if s.m ~= nil then
					d.Material, d.Reflectance, d.CastShadow = s.m, s.r, s.c
				end
				if s.t ~= nil then
					d.TextureID = s.t
				end
				if s.tr ~= nil then
					d.Transparency = s.tr
				end
				if s.en ~= nil then
					d.Enabled = s.en
				end
				if s.sh ~= nil then
					d.Shadows = s.sh
				end
			end
		end
		table.clear(gfx.saved)
		for _, pair in gfx.sa do
			if pair[2].Parent then
				pair[1].Parent = pair[2]
			end
		end
		table.clear(gfx.sa)
		local L = gfx.light
		if L then
			Lit.GlobalShadows, Lit.EnvironmentSpecularScale = L.gs, L.sp
			for e, en in L.fx do
				if e.Parent then
					e.Enabled = en
				end
			end
			pcall(function()
				local t = Workspace.Terrain
				t.Decoration, t.WaterReflectance, t.WaterWaveSize = L.td, L.wr, L.ww
			end)
			pcall(function()
				if L.q then
					settings().Rendering.QualityLevel = L.q
				end
			end)
			gfx.light = nil
		end
	end
	local function gfxSet(level)
		gfx.token += 1
		local my = gfx.token
		gfxRevert()
		gfx.level = level
		if level == 0 then
			return
		end
		gfxLightingOn()
		gfx.conn = Workspace.DescendantAdded:Connect(function(d)
			gfxInst(d, level)
		end)
		task.spawn(function()
			local n = 0
			for _, d in Workspace:GetDescendants() do
				if gfx.token ~= my then
					return
				end
				gfxInst(d, level)
				n += 1
				if n % 300 == 0 then
					task.wait()
				end
			end
		end)
	end

