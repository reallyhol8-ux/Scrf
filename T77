local function col(h)
	return Color3.fromHex(h)
end

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

-- วาดพิกเซลจากลิสต์สี่เหลี่ยม {x, y, w, h}
-- ถ้าใส่ list มาด้วย จะเก็บทุกชิ้น + สีเดิมไว้ (เอาไว้ปรับสีตอนกลางคืน)
local function drawPixels(parent, gw, gh, layers, list)
	local f = make("Frame", {
		Name = "Pixels",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, parent)

	for i, layer in layers do
		for _, r in layer.rects do
			local piece = make("Frame", {
				BackgroundColor3 = col(layer.color),
				BorderSizePixel = 0,
				Position = UDim2.fromScale(r[1] / gw, r[2] / gh),
				Size = UDim2.fromScale(r[3] / gw, r[4] / gh),
				ZIndex = i,
			}, f)
			if list then
				table.insert(list, { f = piece, base = piece.BackgroundColor3 })
			end
		end
	end

	return f
end

local function box(parent, name, w, h, anchor, pos, z)
	return make("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		AnchorPoint = anchor,
		Position = pos,
		Size = UDim2.fromOffset(w, h),
		ZIndex = z,
	}, parent)
end

-- ขอบนูน: ขอบบน/ซ้ายสว่าง ขอบล่าง/ขวามืด
local function bevel(parent, lightSize, darkSize, light, dark, lightTrans, darkTrans)
	local function strip(name, color, trans, pos, size)
		make("Frame", {
			Name = name,
			BackgroundColor3 = col(color),
			BackgroundTransparency = trans,
			BorderSizePixel = 0,
			Position = pos,
			Size = size,
			ZIndex = 40,
		}, parent)
	end
	strip("BevelTop", light, lightTrans, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, lightSize))
	strip("BevelLeft", light, lightTrans, UDim2.fromOffset(0, 0), UDim2.new(0, lightSize, 1, 0))
	strip("BevelBottom", dark, darkTrans, UDim2.new(0, 0, 1, -darkSize), UDim2.new(1, 0, 0, darkSize))
	strip("BevelRight", dark, darkTrans, UDim2.new(1, -darkSize, 0, 0), UDim2.new(0, darkSize, 1, 0))
end

local function makeBtn(parent, name, text, fill, light, dark, border, x)
	local base = col(fill)
	local hover = base:Lerp(Color3.new(1, 1, 1), 0.2)

	local b = make("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, x, 0, 6),
		Size = UDim2.fromOffset(24, 20),
		BackgroundColor3 = base,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = text,
		Font = FONT,
		TextSize = 16,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 30,
	}, parent)

	make("UIStroke", {
		Color = col(border),
		Thickness = 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, b)
	bevel(b, 2, 2, light, dark, 0, 0)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = hover }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)

	return b
end

-- ปรับสีทั้งลิสต์ให้เข้าหาสี target
local function tint(list, target, amount)
	for _, item in list do
		item.f.BackgroundColor3 = item.base:Lerp(target, amount)
	end
end

