-- ปุ่มกระจก (เด้งเหมือนเจลลี่ตอน hover / กด)
local function glassBtn(name, text, x, tint, tintTrans)
	local b = make("TextButton", {
		Name = name,
		Position = UDim2.fromOffset(x, 84),
		Size = UDim2.fromOffset(112, 36),
		BackgroundColor3 = tint,
		BackgroundTransparency = tintTrans,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = text,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	}, glass)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
	make("UIStroke", {
		Color = WHITE,
		Thickness = 1.2,
		Transparency = 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, b)
	local s = make("UIScale", { Scale = 1 }, b)

	local hoverTrans = math.max(tintTrans - 0.15, 0.1)
	b.MouseEnter:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.07 }):Play()
		TweenService:Create(b, tFade, { BackgroundTransparency = hoverTrans }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Scale = 1 }):Play()
		TweenService:Create(b, tFade, { BackgroundTransparency = tintTrans }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.1, Enum.EasingStyle.Quad), { Scale = 0.92 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
	return b
end

