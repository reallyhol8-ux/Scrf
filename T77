	setFeature = function(id, on)
		on = on and true or false
		if (active[id] or false) == on then
			return
		end
		local f = feats[id]
		if not f then
			return
		end
		if on and f.excl and active[f.excl] then
			setFeature(f.excl, false)
		end
		active[id] = on
		local ok, res = pcall(on and f.enable or f.disable)
		if on and (not ok or res == false) then
			active[id] = false
			if not ok then
				notify("เปิดไม่สำเร็จ: " .. tostring(res))
			end
		end
		if ui[id] then
			ui[id](active[id] or false)
		end
	end

